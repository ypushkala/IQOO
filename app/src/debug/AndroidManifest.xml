<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <application>
        <!-- DEBUG BUILDS ONLY: lets adb open the screen directly for UI checks. -->
        <activity android:name="com.callguard.ui.FamilyAlertActivity" android:exported="true" tools:replace="android:exported" />
        <activity android:name="com.callguard.ui.SetupActivity" android:exported="true" tools:replace="android:exported" />
        <activity android:name="com.callguard.ui.ModelImportActivity" android:exported="true" tools:replace="android:exported" />
        <activity android:name="com.callguard.ui.RecoveryActivity" android:exported="true" tools:replace="android:exported" />
        <!-- DEBUG BUILDS ONLY: real-call audio probe (experiment W1). Never part of a release build. -->
        <activity android:name="com.callguard.debug.ProbeActivity" android:exported="false" />
        <service android:name="com.callguard.debug.ProbeService" android:exported="false" android:foregroundServiceType="microphone" />
        <!-- Inert on purpose: it handles no events and reads no screen content. It exists only so we can test whether
             an enabled accessibility service changes what the microphone delivers during a call (experiment E3). -->
        <service
            android:name="com.callguard.debug.ProbeAccessibilityService"
            android:exported="true"
            android:label="CallGuard probe (experiment)"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/probe_accessibility" />
        </service>
    </application>
</manifest>
